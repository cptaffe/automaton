digraph {{ q .Name }} {
{{ template "look" . }}
{{- if .Compound }}
  compound=true
{{- end }}
{{- with .Note }}
  labelloc=t
  labeljust=l
  label={{ flush . }}
{{- end }}
{{- range .Groups }}

  subgraph cluster_{{ .ID }} {
    label={{ flush .Label }}
    labeljust=l
    style="rounded,filled"
    fillcolor="#f8f9fa"
    color="#dee2e6"
    fontcolor="#495057"
    class="group"
    fontsize=10
{{- range .Nodes }}
    {{ template "node" . }}
{{- end }}
  }
{{- end }}
{{ range .Nodes }}
  {{ template "node" . }}
{{- end }}
{{ range .Edges }}
  {{ .From }} -> {{ .To }} [label={{ brk .Label }}, {{ .Paint }}{{ with .Class }}, class={{ printf "%q" . }}{{ end }}{{ if .Dashed }}, style=dashed{{ end }}{{ if .Loose }}, constraint=false{{ end }}]
{{- end }}
}

{{- define "node" -}}
{{ .ID }} [label={{ if .Caption }}<<font point-size="7" color="#868e96">{{ html .Caption }}</font><br/>{{ html .Label }}>{{ else if .Flush }}{{ flush .Label }}{{ else }}{{ q .Label }}{{ end }}{{ with .Shape }}, shape={{ . }}{{ end }}, style="{{ with .Style }}{{ . }},{{ end }}filled", {{ .Paint }}{{ with .Class }}, class={{ printf "%q" . }}{{ end }}{{ if .Twice }}, peripheries=2{{ end }}]
{{- end -}}

{{- define "look" -}}
{{ if eq .Look "machine" }}  rankdir=LR
  graph [fontname="Helvetica", fontsize=11, fontcolor="#343a40", nodesep=0.22, ranksep=0.55]
  node [shape=circle, fontname="Helvetica", fontsize=9, width=0.36, height=0.36, margin="0.1,0.05", penwidth=1]
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.9]
{{ else if eq .Look "shape" }}  rankdir=LR
  graph [fontname="Helvetica", fontsize=11, fontcolor="#343a40", nodesep=0.3, ranksep=0.9]
  node [shape=box, fontname="Helvetica", fontsize=9, margin="0.12,0.07", penwidth=1]
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.9]
{{ else }}{{ fail .Look }}{{ end }}
{{- end -}}
