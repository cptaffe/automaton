{{- /*
  One template for every drawing. A generator says what kind of drawing it is
  making and what is in it; everything about how that looks is here, and
  nothing here names a colour -- a class does that, and the page styles it.

  A label of several lines is written with flush and not brk. Graphviz's \l
  left-justifies the line before it, so a label whose last line has none is
  centred while every line above it is not.
*/ -}}
digraph {{ q .Name }} {
{{ template "look" . }}
{{- if .Compound }}
  compound=true
{{- end }}
{{- with .Note }}
  labelloc=t
  labeljust=l
  label={{ flush . }}
{{- end }}
{{- range .Ranks }}

  { rank={{ .Kind }}
{{- range .IDs }}
    {{ . }}
{{- end }}
  }
{{- end }}
{{- range .Groups }}

  subgraph cluster_{{ .ID }} {
    label={{ flush .Label }}
    labeljust=l
    style=rounded
    class="group"
    fontsize=10
{{- range .Nodes }}
    {{ template "node" . }}
{{- end }}
  }
{{- end }}
{{ range .Nodes }}
  {{ template "node" . }}
{{- end }}
{{ range .Edges }}
  {{ .From }} -> {{ .To }} [label={{ brk .Label }}{{ with .Class }}, class={{ printf "%q" . }}{{ end }}{{ if .Invis }}, style=invis{{ else if .Dashed }}, style=dashed{{ else if .Dotted }}, style=dotted{{ end }}{{ if .Bold }}, fontname="Helvetica-Bold"{{ end }}{{ with .Width }}, penwidth={{ . }}{{ end }}{{ if .Loose }}, constraint=false{{ end }}]
{{- end }}
}

{{- define "node" -}}
{{ .ID }} [label={{ if .Flush }}{{ flush .Label }}{{ else }}{{ q .Label }}{{ end }}{{ with .Shape }}, shape={{ . }}{{ end }}{{ with .Style }}, style={{ printf "%q" . }}{{ end }}{{ with .Class }}, class={{ printf "%q" . }}{{ end }}{{ with .Size }}, width={{ . }}{{ end }}{{ if .Bold }}, fontname="Helvetica-Bold"{{ end }}{{ if .Twice }}, peripheries=2{{ end }}]
{{- end -}}

{{- /* A state machine: states are circles, all the same size whatever the
       number in them, and the reading goes left to right. */ -}}
{{- define "look" -}}
{{ if eq .Look "machine" }}  rankdir=LR
  graph [fontname="Helvetica", fontsize=11, nodesep=0.22, ranksep=0.55]
  node [shape=circle, fontname="Helvetica", fontsize=9, width=0.42, height=0.42, penwidth=0.9]
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.8]
{{ else if eq .Look "shape" }}  rankdir=LR
  graph [fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.9]
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=9, margin="0.12,0.07", penwidth=0.9]
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.8]
{{ else if eq .Look "parse" }}  rankdir=LR
  graph [fontname="Helvetica", fontsize=11, nodesep=0.22, ranksep=0.7]
  node [shape=box, style=rounded, fontname="Helvetica", fontsize=8, margin="0.1,0.06", penwidth=0.9]
  edge [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.8]
{{ else if eq .Look "keypad" }}  rankdir=LR
  bgcolor="transparent"
  fontname="Helvetica-Bold"
  fontsize=11
  node [fontname="Helvetica", fontsize=10, shape=circle, penwidth=1.2]
  edge [fontname="Helvetica", fontsize=9, arrowsize=.7]
{{ else }}{{ fail .Look }}{{ end }}
{{- end -}}
