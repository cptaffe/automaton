%delay T 5s
%delay abandon 16s

start:
  0 T               do operator         -> connected
  0 NXX XXXX        do collect          -> connected
  *98               do voicemail        -> dialing(mailbox)
  NXX XXXX (T | #)  do local            -> connected
  960 NXX XXXX      do long-distance    -> connected
  ... abandon       do dial-again

dialing(then):
  answered          -> then

connected:

mailbox:
  1                 do play       when messages
  #                 do hang-up    -> start
